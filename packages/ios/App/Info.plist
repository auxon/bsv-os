<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An explicit Info.plist rather than Xcode's generated one, because the
	     generated form silently drops keys it does not know: BSVDaemonURL never
	     appeared in the built bundle, so the app could not be pointed at a
	     daemon without editing source. Verified by inspecting the built
	     bundle's plist, not by trusting the build setting. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>bsvOS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The daemon this build talks to. Change it to the machine's VPN address
	     for a build that runs on a phone; the default only works in a simulator
	     on the daemon's own machine. -->
	<key>BSVDaemonURL</key>
	<string>https://127.0.0.1:2121</string>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Camera and microphone, for Cast's record flow. WKWebView asks the app
	     for these the first time a page calls getUserMedia; without the usage
	     strings the app is terminated by the system instead of prompting. -->
	<key>NSCameraUsageDescription</key>
	<string>Cast records video from the camera for your episodes.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cast records audio for your episodes.</string>

	<!-- The bundled apps are served over loopback HTTP so they get a real web
	     origin (file:// is not one: modules and getUserMedia refuse to work
	     there). This key allows that local connection without loosening ATS
	     for anything else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
