<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately empty, and deliberately the default.

	     Push requires the aps-environment entitlement, which a PERSONAL (free)
	     development team cannot use — Xcode refuses to create a provisioning
	     profile for it: "Personal development teams do not support the Push
	     Notifications capability". Shipping that entitlement by default would
	     make the app unbuildable on a free account, for a feature that is not
	     needed to use the wallet.

	     So push lives in BSVOS.push.entitlements and is switched on by the
	     BSVOS_ENTITLEMENTS build setting. See docs/ios.md. -->
</dict>
</plist>
