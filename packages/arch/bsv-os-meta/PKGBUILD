# Maintainer: EntangleIT <bsv-os@entangleit.com>
pkgname=bsv-os-meta
pkgver=0.1.0
pkgrel=2
pkgdesc="BSV OS layer for Omarchy: system BRC-100 wallet daemon, CLI, shell plugins"
arch=('aarch64')
url="https://github.com/auxon/bsv-os"
license=('Open BSV License')
depends=(
  'nodejs>=22'      # walletd runtime (aarch64); prebuilt ARM deps verified
  'libsecret'       # keytar runtime: GNOME Keyring access
  'gnome-keyring'   # login keyring provider
  'sqlite'          # wallet + monitor databases
  'python' 'make' 'gcc'  # node-gyp fallback if a prebuild 404s
)
optdepends=(
  'quickshell: wallet bar widgets and pay prompts'
  'openssh: agent access for remote setup'
  'chromium: sandboxed runner windows for installed apps'
  'openssl: throwaway TLS cert for the loopback runner demo'
)
source=('bsv.sh')
sha256sums=('SKIP')

package() {
  local src="$startdir/../../../packages/walletd"
  [ -d "$src/dist" ] || { echo "run npm run build in packages/walletd first"; exit 1; }
  install -dm755 "$pkgdir/usr/lib/bsv-os/walletd"
  cp -a "$src/dist" "$pkgdir/usr/lib/bsv-os/walletd/"
  cp -a "$src/package.json" "$pkgdir/usr/lib/bsv-os/walletd/"
  # production node_modules (pinned ARM prebuilds) installed at package time
  cd "$pkgdir/usr/lib/bsv-os/walletd" && npm install --omit=dev --no-audit --no-fund

  install -Dm755 "$srcdir/bsv.sh" "$pkgdir/usr/bin/bsv"
  install -Dm644 "$src/bsv-walletd.service" "$pkgdir/usr/lib/systemd/user/bsv-walletd.service"

  # Omarchy manifest plugin source (user syncs it into
  # ~/.config/omarchy/plugins/bsv.wallet/ via scripts/post-install.sh —
  # packages must not mutate $HOME at install time).
  local plugin="$startdir/../../../packages/shell/plugin"
  if [ -d "$plugin" ]; then
    install -dm755 "$pkgdir/usr/share/bsv-os/shell-plugin"
    cp -a "$plugin/." "$pkgdir/usr/share/bsv-os/shell-plugin/"
  fi

  # F2 runner: bridge extension + loopback demo + F1 store catalog (the CLI
  # resolves them from here when not running out of a repo checkout).
  local runner="$startdir/../../../packages/runner"
  if [ -d "$runner/extension" ]; then
    install -dm755 "$pkgdir/usr/share/bsv-os/runner"
    cp -a "$runner/extension" "$pkgdir/usr/share/bsv-os/runner/"
    [ -f "$runner/store.json" ] && cp -a "$runner/store.json" "$pkgdir/usr/share/bsv-os/runner/"
    [ -d "$runner/demo" ] && cp -a "$runner/demo" "$pkgdir/usr/share/bsv-os/runner/"
  fi

  # File-manager share target (scripts/install.sh copies it into the
  # Nautilus scripts dir — no $HOME mutation at package time).
  local nautilus="$startdir/../../../packages/shell/nautilus"
  if [ -d "$nautilus" ]; then
    install -dm755 "$pkgdir/usr/share/bsv-os/nautilus"
    cp -a "$nautilus/." "$pkgdir/usr/share/bsv-os/nautilus/"
  fi
}
