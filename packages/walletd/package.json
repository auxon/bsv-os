{
  "name": "@bsv-os/walletd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "bsv-walletd: system BRC-100 wallet daemon for the BSV OS (Omarchy remix)",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/**/*.test.mjs'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@bsv/sdk": "^2.6.0",
    "@bsv/wallet-toolbox": "^2.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scure/bip39": "^2.4.0",
    "better-sqlite3": "12.11.1",
    "keytar": "7.9.0",
    "knex": "^3.1.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3"
  },
  "bin": {
    "bsv": "./dist/cli.js"
  }
}
